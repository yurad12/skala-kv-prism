# cp .env.example .env 후 값을 채웁니다. .env는 git에 올라가지 않습니다.

# LLM (Generator / Judge)
OPENAI_API_KEY=
GENERATOR_MODEL=
JUDGE_MODEL=

# 웹 검색 도구
TAVILY_API_KEY=

# 임베딩 (기본값: BAAI/bge-m3, HuggingFace 공개 모델이라 토큰은 선택)
EMBEDDING_MODEL=BAAI/bge-m3
HF_TOKEN=

# 재현 모드: 1이면 outputs/cache 의 검색·LLM 응답을 재사용
REPLAY=0
